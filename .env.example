PORVOZ_ADMIN_KEY=replace-with-a-long-random-admin-key
PORVOZ_MASTER_KEY=replace-with-a-different-long-random-master-key
PORVOZ_PORT=8080
PORVOZ_IMAGE_TAG=latest

# Browser administration. Set PORVOZ_WEB_ADMIN=off to serve only the API.
# PORVOZ_WEB_ALLOW_INSECURE=true permits sign-in over plain HTTP from a
# trusted network; recording still requires HTTPS or a localhost address.
PORVOZ_WEB_ADMIN=on
PORVOZ_WEB_ALLOW_INSECURE=false
# Comma-separated proxy addresses whose forwarded headers are trusted, for
# example an HTTPS reverse proxy at 172.18.0.0/16.
PORVOZ_TRUSTED_PROXIES=
